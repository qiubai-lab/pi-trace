{
  "name": "@qiubai-lab/pi-trace",
  "version": "0.1.0",
  "private": true,
  "description": "Local, loss-aware execution tracing for Pi",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/qiubai-lab/pi-trace.git"
  },
  "keywords": [
    "pi-package",
    "observability",
    "tracing"
  ],
  "files": [
    "bin/",
    "dist/web/",
    "src/",
    "scripts/install-qb-trace-cli.sh",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "qb-trace": "bin/qb-trace"
  },
  "scripts": {
    "install:cli": "./scripts/install-qb-trace-cli.sh",
    "dev:web": "vite --config vite.config.ts",
    "build:web": "vite build --config vite.config.ts",
    "benchmark:web": "node --no-warnings=ExperimentalWarning scripts/benchmark-web.ts",
    "prepare": "npm run build:web",
    "test": "npm run build:web && vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json --noEmit"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "22.19.19",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "typescript": "5.9.3",
    "vite": "^8.3.0",
    "vitest": "4.1.9"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-virtual": "^3.14.11",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
